public Account (String requestedname){

  private String username;

  public Account(String requestedName){
    int num=1;
    while (!isAvailable(requestedName)){
      requestedName=requestedName+num;
      num++;
    }
    username=requestedName;
  }

  public String getShortenedName(){
    String f=username;
    while (!f.indexOf("-")==-1){
      f=f.substring(0,f.indexOf("-")-1);
    }
    return f;
  }
  
}
